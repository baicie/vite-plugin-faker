{
  "name": "@baicie/webpack-plugin-faker",
  "version": "0.1.1-beta.0",
  "description": "Webpack plugin for mocking API requests with faker",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baicie/vite-plugin-faker.git",
    "directory": "packages/webpack-plugin-faker"
  },
  "homepage": "https://github.com/baicie/vite-plugin-faker#readme",
  "bugs": {
    "url": "https://github.com/baicie/vite-plugin-faker/issues"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "rolldown --config rolldown.config.ts --watch",
    "build": "rimraf dist && rolldown --config rolldown.config.ts --minify && node ../../scripts/create-cjs-declarations.js dist",
    "typecheck": "tsc --incremental --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "webpack-plugin",
    "faker",
    "mock",
    "api"
  ],
  "dependencies": {
    "@baicie/faker-interceptor": "workspace:*",
    "@baicie/faker-shared": "workspace:*",
    "@baicie/faker-core": "workspace:*",
    "@baicie/faker-ui": "workspace:*",
    "@baicie/logger": "^0.1.3",
    "@faker-js/faker": "^10.3.0",
    "chokidar": "^5.0.0",
    "co-body": "^6.2.0",
    "lodash-es": "^4.18.1",
    "lowdb": "^7.0.1",
    "qs": "^6.15.0",
    "type-is": "^2.0.1",
    "ws": "^8.21.3",
    "picocolors": "^1.1.1"
  },
  "peerDependencies": {
    "webpack": "^5.0.0",
    "webpack-dev-server": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@types/co-body": "^6.1.3",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.24",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.3.5",
    "@types/qs": "^6.15.0",
    "@types/type-is": "^1.6.7",
    "@types/ws": "^8.18.1",
    "fs-extra": "^11.3.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "webpack": "^5.105.4",
    "webpack-dev-server": "^5.2.3"
  }
}
