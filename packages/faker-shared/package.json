{
  "name": "@baicie/faker-shared",
  "version": "1.0.0",
  "description": "Shared types and utilities for the Baicie Faker plugins",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baicie/vite-plugin-faker.git",
    "directory": "packages/faker-shared"
  },
  "homepage": "https://github.com/baicie/vite-plugin-faker#readme",
  "bugs": {
    "url": "https://github.com/baicie/vite-plugin-faker/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    }
  },
  "scripts": {
    "build": "rimraf dist && rolldown --minify -c && node ../../scripts/create-cjs-declarations.js dist && pnpm run verify-build",
    "dev": "rolldown --watch -c",
    "typecheck": "tsc --incremental --noEmit",
    "verify-build": "node scripts/verify-build.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@types/lodash-es": "^4.17.12"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.3.0",
    "lodash-es": "^4.18.1",
    "rolldown": "1.0.0-rc.7",
    "rolldown-plugin-dts": "^0.22.4",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@faker-js/faker": "^10.1.0",
    "lodash-es": "^4.18.0"
  }
}
