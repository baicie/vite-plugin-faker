{
  "name": "@baicie/faker-shared",
  "version": "1.0.0",
  "description": "Shared types and utilities for the Baicie Faker plugins",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baicie/vite-plugin-faker.git",
    "directory": "packages/faker-shared"
  },
  "homepage": "https://github.com/baicie/vite-plugin-faker#readme",
  "bugs": {
    "url": "https://github.com/baicie/vite-plugin-faker/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.js"
    }
  },
  "scripts": {
    "build": "rolldown --minify -c",
    "dev": "rolldown --watch -c",
    "typecheck": "tsc --incremental --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@baicie/logger": "^0.1.3",
    "@faker-js/faker": "^10.3.0",
    "@types/lodash-es": "^4.17.12",
    "lodash-es": "^4.17.23",
    "rolldown": "1.0.0-rc.7",
    "rolldown-plugin-dts": "^0.22.4",
    "typescript": "^5.9.3",
    "vite": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@faker-js/faker": "^10.1.0",
    "lodash-es": "^4.17.22"
  }
}
