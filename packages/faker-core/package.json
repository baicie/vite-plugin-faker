{
  "name": "@baicie/faker-core",
  "version": "0.1.0",
  "description": "Core logic for faker plugins",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baicie/vite-plugin-faker.git",
    "directory": "packages/faker-core"
  },
  "homepage": "https://github.com/baicie/vite-plugin-faker#readme",
  "bugs": {
    "url": "https://github.com/baicie/vite-plugin-faker/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "rimraf dist && rolldown --minify -c && node ../../scripts/create-cjs-declarations.js dist",
    "dev": "rolldown --watch -c",
    "typecheck": "tsc --incremental --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@baicie/faker-shared": "workspace:*",
    "@baicie/logger": "^0.1.3",
    "@faker-js/faker": "^10.3.0",
    "co-body": "^6.2.0",
    "lodash-es": "^4.18.1",
    "lowdb": "^7.0.1",
    "qs": "^6.15.0",
    "type-is": "^2.0.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/co-body": "^6.1.3",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.24",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.3.5",
    "@types/qs": "^6.15.0",
    "@types/type-is": "^1.6.7",
    "@types/ws": "^8.18.1",
    "fs-extra": "^11.3.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
