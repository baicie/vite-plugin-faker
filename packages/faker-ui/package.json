{
  "name": "@baicie/faker-ui",
  "version": "0.1.1-beta.0",
  "description": "Browser UI for the Baicie Faker plugins",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baicie/vite-plugin-faker.git",
    "directory": "packages/faker-ui"
  },
  "homepage": "https://github.com/baicie/vite-plugin-faker#readme",
  "bugs": {
    "url": "https://github.com/baicie/vite-plugin-faker/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "css": "dist/index.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/node.js",
      "import": "./dist/index.js",
      "css": "./dist/index.css"
    },
    "./dist/index.js": "./dist/index.js",
    "./dist/index.css": "./dist/index.css"
  },
  "scripts": {
    "dev": "vite build --watch",
    "analyze": "cross-env ANALYZE=true vite build",
    "vite": "vite",
    "build": "rimraf dist && tsc --noEmit && rolldown --config rolldown.config.ts && vite build && node scripts/verify-build.mjs",
    "verify-build": "node scripts/verify-build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --incremental --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@baicie/faker-shared": "workspace:*",
    "@baicie/logger": "^0.1.3",
    "@monaco-editor/loader": "^1.7.0",
    "@zeus-js/zeus": "0.1.0-beta.8",
    "@zeus-web/button": "0.1.0-beta.2",
    "@zeus-web/dialog": "0.1.0-beta.2",
    "@zeus-web/icons": "0.1.0-beta.2",
    "@zeus-web/input": "0.1.0-beta.2",
    "@zeus-web/select": "0.1.0-beta.2",
    "@zeus-web/switch": "0.1.0-beta.2",
    "@zeus-web/tabs": "0.1.0-beta.2",
    "@zeus-web/ui": "0.1.0-beta.2",
    "monaco-editor": "^0.55.1"
  },
  "devDependencies": {
    "rolldown": "1.0.0-rc.7",
    "rolldown-plugin-dts": "^0.22.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "~5.9.3",
    "vite": "catalog:"
  }
}
