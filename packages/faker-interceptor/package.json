{
  "name": "@baicie/faker-interceptor",
  "version": "0.1.0",
  "description": "Browser-side request interceptor with Faker.js support",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baicie/vite-plugin-faker.git",
    "directory": "packages/faker-interceptor"
  },
  "homepage": "https://github.com/baicie/vite-plugin-faker#readme",
  "bugs": {
    "url": "https://github.com/baicie/vite-plugin-faker/issues"
  },
  "type": "module",
  "main": "dist/interceptor.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/interceptor.js"
    },
    "./dist/interceptor.js": "./dist/interceptor.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "rolldown --config rolldown.config.ts --watch",
    "build": "rolldown --config rolldown.config.ts --minify",
    "typecheck": "tsc --incremental --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@baicie/logger": "^0.1.3",
    "@faker-js/faker": "^10.3.0"
  },
  "devDependencies": {
    "@baicie/faker-shared": "workspace:*",
    "rolldown": "1.0.0-rc.7",
    "rolldown-plugin-dts": "^0.22.4",
    "typescript": "~5.9.3",
    "vite": "catalog:"
  }
}
