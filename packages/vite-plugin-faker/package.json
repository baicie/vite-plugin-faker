{
  "name": "@baicie/vite-plugin-faker",
  "version": "0.1.1-beta.0",
  "description": "Vite插件，用于拦截API请求并使用faker进行模拟数据",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baicie/vite-plugin-faker.git",
    "directory": "packages/vite-plugin-faker"
  },
  "homepage": "https://github.com/baicie/vite-plugin-faker#readme",
  "bugs": {
    "url": "https://github.com/baicie/vite-plugin-faker/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "rolldown --config rolldown.config.ts --watch",
    "build": "rimraf dist && rolldown --config rolldown.config.ts --minify",
    "typecheck": "tsc --incremental --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "vite-plugin",
    "faker",
    "mock",
    "api"
  ],
  "dependencies": {
    "@baicie/faker-interceptor": "workspace:*",
    "@baicie/faker-shared": "workspace:*",
    "@baicie/faker-core": "workspace:*",
    "@baicie/faker-ui": "workspace:*",
    "@baicie/logger": "^0.1.3",
    "@faker-js/faker": "^10.3.0",
    "chokidar": "^5.0.0",
    "co-body": "^6.2.0",
    "lodash-es": "^4.18.1",
    "lowdb": "^7.0.1",
    "picocolors": "^1.1.1",
    "qs": "^6.15.0",
    "type-is": "^2.0.1",
    "ws": "^8.21.3"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "@types/co-body": "^6.1.3",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.24",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.3.5",
    "@types/qs": "^6.15.0",
    "@types/type-is": "^1.6.7",
    "@types/ws": "^8.18.1",
    "fs-extra": "^11.3.4",
    "vite": "catalog:"
  }
}
