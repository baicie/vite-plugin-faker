{
  "name": "root",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.19.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1.x": "1.1.18",
      "brace-expansion@2.x": "2.1.4",
      "brace-expansion@5.x": "5.0.9",
      "caniuse-lite": "1.0.30001809",
      "defu": "6.1.5",
      "fast-uri": "3.1.5",
      "flatted": "3.4.4",
      "form-data": "4.0.6",
      "js-cookie": "3.0.7",
      "js-yaml@3.x": "3.15.1",
      "js-yaml@4.x": "4.3.1",
      "js-yaml@5.x": "5.2.2",
      "jws@3.x": "3.2.3",
      "lodash": "4.18.1",
      "minimatch@3.x": "3.1.5",
      "minimatch@9.x": "9.0.9",
      "minimatch@10.x": "10.2.6",
      "multer": "2.2.0",
      "nanoid@3.x": "3.3.18",
      "node-forge": "1.4.0",
      "path-to-regexp@0.x": "0.1.13",
      "path-to-regexp@8.x": "8.4.2",
      "picomatch@2.x": "2.3.2",
      "picomatch@4.x": "4.0.4",
      "postcss": "8.5.26",
      "rollup": "4.62.4",
      "shell-quote": "1.10.0",
      "undici@7.x": "7.29.0",
      "websocket-driver": "0.7.5",
      "@babel/core@7.x": "7.29.7",
      "@nestjs/core@11.x": "11.1.28",
      "ajv@8.x": "8.20.0",
      "body-parser@1.x": "1.20.6",
      "body-parser@2.x": "2.3.0",
      "diff@4.x": "4.0.4",
      "dompurify@3.x": "3.4.13",
      "file-type@21.x": "21.3.2",
      "follow-redirects@1.x": "1.16.0",
      "http-proxy-middleware@2.x": "2.0.10",
      "joi@18.x": "18.2.3",
      "launch-editor@2.x": "2.14.1",
      "node-notifier>uuid": "11.1.1",
      "protocol-buffers-schema@3.x": "3.6.1",
      "qs@6.x": "6.15.3",
      "sockjs>uuid": "11.1.1",
      "turbo@2.x": "2.9.14",
      "webpack-dev-server@5.x": "5.2.6",
      "yaml@2.x": "2.8.3"
    },
    "patchedDependencies": {
      "image-size@2.0.2": "patches/image-size@2.0.2.patch"
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2025-71330",
        "CVE-2025-71329"
      ]
    }
  },
  "scripts": {
    "# Scrips for group #": "_",
    "dev": "turbo run dev --filter=!./playground/*",
    "build": "turbo run build",
    "clean": "rimraf --glob packages/*/dist temp .eslintcache",
    "# Scrips for check #": "_",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint --cache .",
    "lint-fix": "eslint --fix .",
    "format": "prettier --write --cache .",
    "format-check": "prettier --check --cache .",
    "audit:dependencies": "pnpm audit --registry=https://registry.npmjs.org",
    "# Scrips for test #": "_",
    "test": "vitest",
    "test-unit": "vitest --project unit",
    "test-e2e": "pnpm --filter vitesse-webext test:e2e",
    "test-coverage": "vitest run --coverage",
    "test:all": "pnpm -r test",
    "# Scrips for release #": "_",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release:check": "node scripts/ci-helper.js",
    "release:smoke": "node scripts/verify-package-install.js",
    "release": "pnpm build && pnpm release:check && pnpm release:smoke && cross-env npm_config_ignore_scripts=true changeset publish",
    "# Scrips for dev #": "_",
    "dev-shared": "pnpm --filter ./packages/faker-shared dev",
    "dev-faker-interceptor": "pnpm --filter ./packages/faker-interceptor dev",
    "dev-faker-ui": "pnpm --filter ./packages/faker-ui dev",
    "dev-vite-plugin-faker": "pnpm --filter ./packages/vite-plugin-faker dev",
    "dev-vue-app": "pnpm --filter ./playground/vue-app dev",
    "dev-webpack-app": "pnpm --filter ./playground/webpack-app dev",
    "dev-backend": "pnpm --filter ./playground/api-server dev",
    "# Scrips for build #": "_",
    "build-shared": "pnpm --filter ./packages/faker-shared build",
    "build-faker-interceptor": "pnpm --filter ./packages/faker-interceptor build",
    "build-faker-ui": "pnpm --filter ./packages/faker-ui build",
    "build-vite-plugin-faker": "pnpm --filter ./packages/vite-plugin-faker build"
  },
  "devDependencies": {
    "@baicie/scripts": "^0.1.2",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.3.5",
    "@vitejs/plugin-vue-jsx": "^5.1.4",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.26",
    "chokidar": "^5.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.1",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-regexp": "^3.0.0",
    "fs-extra": "^11.3.4",
    "globals": "^17.4.0",
    "jsdom": "^28.1.0",
    "npm-run-all2": "^8.0.4",
    "picocolors": "^1.1.1",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "rolldown": "1.0.0-rc.7",
    "rolldown-plugin-dts": "^0.22.4",
    "tsx": "^4.21.0",
    "turbo": "^2.8.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
